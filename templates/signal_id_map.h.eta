#ifndef SIGNAL_ID_MAP_H
#define SIGNAL_ID_MAP_H

#include "pub_sig_def.h"

typedef enum {
<% it.localRows.forEach((row) => { %>    /* <%~ row.description %>（UPM单板测点第 <%~ row.excelRow %> 行） */
    <%~ row.name %> = <%~ row.value %>,
<% }) %>} LOCAL_SIGNAL_ID_E;

typedef enum {
<% it.dspRows.forEach((row) => { %>    /* <%~ row.description %>（UPM-DSP采集数据第 <%~ row.excelRow %> 行） */
    <%~ row.name %> = <%~ row.value %>,
<% }) %>} DSP_SIGNAL_ID_E;

#endif /* SIGNAL_ID_MAP_H */
